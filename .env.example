# Copy to .env for local runs. On BotKeep put these in Environment (token as a secret).
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot (empty = everyone). Get yours with /id.
ALLOWED_USER_IDS=
DEFAULT_VOICE=Ngọc Huyền
MAX_CHARS=600
# Max characters of an uploaded .txt file (40000 ≈ 35 min audio, ~19 MB MP3; Telegram cap is 50 MB)
MAX_FILE_CHARS=40000
VIENEU_THREADS=2
# Max characters per model chunk. Lower = less peak RAM (256 → +1.3 GB, 128 → +0.45 GB, 96 → +0.3 GB)
CHUNK_CHARS=128
# fp32 (safe) | int8 (faster, ~0.9 GB RAM, ONLY if the CPU has VNNI)
VIENEU_PRECISION=fp32
